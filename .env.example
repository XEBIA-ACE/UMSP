# requirements.txt
# Python 3.12+ required (upgraded from 3.8 EOL)
# Updated to reflect modernized stack: Flask 3.1, SQLAlchemy 2.0

# ---------------------------------------------------------------------------
# Web Framework
# Flask 1.x (EOL) → 3.1 (critical upgrade)
# Adopts application factory pattern; Werkzeug and Click are bundled as deps
# ---------------------------------------------------------------------------
Flask==3.1.0

# ---------------------------------------------------------------------------
# ORM
# SQLAlchemy 1.3 (EOL) → 2.0 (critical upgrade)
# Legacy Query API removed; use Session.execute() with select() constructs
# ---------------------------------------------------------------------------
SQLAlchemy==2.0.36

# ---------------------------------------------------------------------------
# WSGI adapter for Flask (replaces direct flask.run in production)
# New in modernized stack: explicit WSGI server required for production use
# Flask 3.x no longer recommends the built-in dev server for any deployment
# ---------------------------------------------------------------------------
gunicorn==22.0.0

# ---------------------------------------------------------------------------
# Environment variable / secrets configuration
# Replaces hardcoded credentials; required by upgrade target
# python-dotenv loads .env files into os.environ for local development
# ---------------------------------------------------------------------------
python-dotenv==1.0.1

# ---------------------------------------------------------------------------
# Database driver (retain existing; version pinned for Python 3.12 compat)
# Update the driver package below to match your actual database backend.
# Examples:
#   PostgreSQL : psycopg2-binary==2.9.9
#   MySQL      : PyMySQL==1.1.1
#   SQLite     : no additional driver required (stdlib)
# ---------------------------------------------------------------------------
# psycopg2-binary==2.9.9

# ---------------------------------------------------------------------------
# Flask-SQLAlchemy integration shim
# Version 3.x is required for SQLAlchemy 2.0 compatibility
# Flask-SQLAlchemy 2.x is NOT compatible with SQLAlchemy 2.0
# ---------------------------------------------------------------------------
Flask-SQLAlchemy==3.1.1

# ---------------------------------------------------------------------------
# Development / testing dependencies
# Pin to versions validated against Python 3.12
# ---------------------------------------------------------------------------
pytest==8.2.2
pytest-flask==1.3.0        # Flask test-client helpers for pytest
coverage==7.5.3            # Code coverage reporting