The upgrade goal is to replace unittest with pytest and add fixture-based DB isolation. The base source code contains a `user-management/package.json` (Jest-based Node.js project) but no Python configuration files. Since the spec describes migrating to pytest for a Python context, and no original `pytest.ini`, `pyproject.toml`, or `conftest.py` exists in the base source, I need to generate complete, usable configuration files from scratch based solely on the upgrade context and spec.

The relevant files to generate are:
1. `pytest.ini` (or `pyproject.toml` pytest section) — pytest configuration
2. `conftest.py` — fixture definitions for DB isolation

I'll generate `pyproject.toml` as the canonical Python config file (covers pytest config + dependencies), and `conftest.py` for fixtures.

Since only one file can be returned, I'll generate `conftest.py` as it is the most critical new artifact (the fixture-based DB isolation piece), and embed pytest config in `pyproject.toml`. Actually, re-reading the rules: "Generate an updated configuration file" — I'll produce `pyproject.toml` as the primary configuration file since it covers both the build tool (pip) config and pytest settings.

[FILE: pyproject.toml]

[pyproject.toml]

# pyproject.toml — Python project configuration for user-management service
# Introduced by upgrade: Replace unittest with pytest + fixture-based DB isolation
# Python target: 3.12 / 3.13  (upgraded from 3.8 EOL)
# Flask target:  3.1           (upgraded from 1.x EOL)
# SQLAlchemy:    2.0           (upgraded from 1.3 EOL)

[build-system]
# Standard PEP 517 build backend; required by pip for editable installs
requires = ["setuptools>=68", "wheel"]
build-backend = "setuptools.backends.legacy:build"

[project]
name = "user-management-service"
version = "1.0.0"
description = "User Management Service — registration, login, password recovery, account verification"
# Upgraded from Python 3.8 (EOL) to 3.12+
requires-python = ">=3.12"

dependencies = [
    # Upgraded from Flask 1.x (EOL) to Flask 3.1 (critical urgency)
    "flask>=3.1,<4.0",
    # Upgraded from SQLAlchemy 1.3 (EOL) to SQLAlchemy 2.0 (critical urgency)
    # SQLAlchemy 2.0 introduces new query API (select(), Session.execute(), etc.)
    "sqlalchemy>=2.0,<3.0",
    # Flask-SQLAlchemy 3.x is required for SQLAlchemy 2.0 compatibility
    "flask-sqlalchemy>=3.1,<4.0",
    # Secrets management: read credentials from environment variables
    # Replaces any hardcoded credentials in the codebase
    "python-dotenv>=1.0,<2.0",
    # JWT support (equivalent to jsonwebtoken in the Node.js service)
    "pyjwt>=2.8,<3.0",
    # Password hashing (equivalent to bcryptjs in the Node.js service)
    "bcrypt>=4.1,<5.0",
    # UUID generation (stdlib in Python 3, no extra dep needed)
    # Email sending via SMTP
    "flask-mail>=0.10,<1.0",
]

[project.optional-dependencies]
# All test dependencies — installed via: pip install -e ".[test]"
test = [
    # Upgraded from unittest (stdlib) to pytest as the primary test runner
    "pytest>=8.2,<9.0",
    # pytest-flask: provides the `app` and `client` fixtures for Flask 3.x apps
    # New fixture introduced by upgrade — replaces manual test client setup
    "pytest-flask>=1.3,<2.0",
    # SQLAlchemy 2.0-compatible in-process SQLite DB for fixture-based isolation
    # Each test gets a fresh DB via the `db_session` fixture in conftest.py
    "pytest-sqlalchemy-mock>=0.1,<1.0",
    # Coverage reporting — replaces Jest's built-in coverage
    "pytest-cov>=5.0,<6.0",
    # Async test support (if any async routes are added under Flask 3.x)
    "pytest-asyncio>=0.23,<1.0",
    # Factory-boy for generating test fixtures (replaces manual object construction)
    "factory-boy>=3.3,<4.0",
    # HTTP-level integration testing (equivalent to supertest in Node.js)
    # Provided by pytest-flask's `client` fixture; no extra dep needed for basic use
]

dev = [
    "nodemon",   # kept for reference; Python equivalent is watchdog or flask --debug
    # Linting and formatting
    "ruff>=0.4,<1.0",
    "mypy>=1.10,<2.0",
]

# ---------------------------------------------------------------------------
# pytest configuration
# Replaces Jest config block that was in package.json:
#   "jest": { "testEnvironment": "node", "testMatch": [...], ... }
# ---------------------------------------------------------------------------
[tool.pytest.ini_options]

# Root directory pytest searches for tests — mirrors Jest's testMatch pattern
# "**/src/__tests__/**/*.test.js"  →  "tests/" directory with test_*.py files
testpaths = [
    "tests",          # primary test directory (unit + integration)
]

# File and function naming conventions (pytest defaults, made explicit)
# Replaces Jest's implicit *.test.js discovery
python_files   = ["test_*.py", "*_test.py"]
python_classes = ["Test*"]
python_functions = ["test_*"]

# Minimum pytest version required (matches the pinned dep above)
minversion = "8.2"

# Markers declared here prevent PytestUnknownMarkWarning
# New markers introduced by the fixture-based DB isolation upgrade:
markers = [
    # Applied to any test that touches the database layer via the db_session fixture
    "db: marks tests that require fixture-based database isolation (deselect with -m 'not db')",
    # Applied to full HTTP-stack tests that spin up the Flask test client
    "integration: marks integration tests that load the full Flask application context",
    # Applied to pure unit tests with no I/O (fastest subset)
    "unit: marks pure unit tests with no database or HTTP I/O",
]

# Default addopts applied to every pytest invocation
# --strict-markers  : fail if an undeclared marker is used (enforces the list above)
# --tb=short        : concise tracebacks (equivalent to Jest's default output)
# -ra               : show a short summary of all non-passing tests at the end
addopts = [
    "--strict-markers",
    "--tb=short",
    "-ra",
]

# asyncio_mode = "auto" enables pytest-asyncio to collect async test functions
# without requiring the @pytest.mark.asyncio decorator on every function.
# Introduced because Flask 3.x supports async view functions.
asyncio_mode = "auto"

# ---------------------------------------------------------------------------
# Coverage configuration (replaces Jest's coverageDirectory / collectCoverageFrom)
# Run with: pytest --cov=src --cov-report=html --cov-report=term-missing
# ---------------------------------------------------------------------------
[tool.coverage.run]
# Source paths to measure — mirrors Jest's collectCoverageFrom: ["src/**/*.js"]
source = ["src"]

# Omit test files themselves and migration scripts from coverage measurement
omit = [
    "tests/*",
    "src/migrations/*",
    "src/config/settings.py",   # pure config, no logic to cover
]

# Branch coverage enabled to catch untested conditional paths
branch = true

[tool.coverage.report]
# Fail the CI step if overall coverage drops below this threshold
# (Jest had no explicit threshold; this is a new quality gate)
fail_under = 80

# Show lines not covered in the terminal report
show_missing = true

# Exclude boilerplate lines from coverage counts
exclude_lines = [
    "pragma: no cover",
    "if __name__ == .__main__.:",
    "raise NotImplementedError",
    "\\.\\.\\.",          # abstract method stubs
    "pass",
]

[tool.coverage.html]
# Output directory — mirrors Jest's coverageDirectory: "coverage"
directory = "coverage/html"

[tool.coverage.xml]
# XML report consumed by CI/CD vulnerability and coverage tools
output = "coverage/coverage.xml"

# ---------------------------------------------------------------------------
# Ruff linter configuration (replaces ESLint from the Node.js toolchain)
# ---------------------------------------------------------------------------
[tool.ruff]
# Target the upgraded Python version
target-version = "py312"
line-length = 100

[tool.ruff.lint]
select = [
    "E",   # pycodestyle errors
    "W",   # pycodestyle warnings
    "F",   # pyflakes
    "I",   # isort
    "UP",  # pyupgrade — enforces Python 3.12+ idioms
]
ignore = [
    "E501",  # line too long — handled by formatter
]

# ---------------------------------------------------------------------------
# Mypy type-checking configuration
# ---------------------------------------------------------------------------
[tool.mypy]
python_version = "3.12"
strict = false
# SQLAlchemy 2.0 ships its own stubs; no extra mypy plugin needed for basic use
plugins = ["sqlalchemy.ext.mypy.plugin"]
ignore_missing_imports = true