The upgrade goal is to replace unittest with pytest and add fixture-based DB isolation. The base source code contains a `user-management/package.json` (Jest-based Node.js project) and no existing `pytest.ini`, `conftest.py`, or `pyproject.toml` for Python testing. Since the spec describes migrating to pytest for a Python context and no original Python config file exists, I need to generate a complete, usable `pyproject.toml` (the standard pytest configuration file for modern Python projects) from scratch, based solely on the upgrade context and spec.

[pyproject.toml]

[build-system]
# PEP 517/518 build system declaration — required for pip-based projects
requires = ["setuptools>=68", "wheel"]
build-backend = "setuptools.backends.legacy:build"

[project]
# Project metadata derived from the user-management service description
name = "user-management-service"
version = "1.0.0"
description = "User Management Service — registration, login, password recovery, account verification"
# Target Python version per upgrade goal (3.12 is the recommended stable LTS target)
requires-python = ">=3.12"

# Runtime dependencies mapped from package.json equivalents for the Python service layer
dependencies = [
    # Flask 3.x — upgraded from 1.x (critical urgency); application factory pattern required
    "flask>=3.1,<4.0",
    # SQLAlchemy 2.0 — upgraded from 1.3 (critical urgency); new query API (select() style)
    "sqlalchemy>=2.0,<3.0",
    # python-dotenv replaces hardcoded credentials; loads .env for environment-based secrets
    "python-dotenv>=1.0",
    # PyJWT for JWT issuance and validation (replaces jsonwebtoken)
    "PyJWT>=2.8",
    # bcrypt for password hashing (replaces bcryptjs)
    "bcrypt>=4.1",
    # uuid is part of Python stdlib — no separate dependency needed
]

[project.optional-dependencies]
# Test dependencies — replaces Jest 29 + supertest with pytest ecosystem
dev = [
    # pytest replaces unittest/Jest as the primary test runner (core upgrade goal)
    "pytest>=8.2",
    # pytest-flask provides the `app` and `client` fixtures for Flask integration tests
    "pytest-flask>=1.3",
    # pytest-cov replaces Jest --coverage for test coverage reporting
    "pytest-cov>=5.0",
    # Faker generates realistic test data (replaces manual stubs in Jest tests)
    "faker>=25.0",
    # httpx used as the test HTTP client for REST API integration tests (replaces supertest)
    "httpx>=0.27",
]

# ---------------------------------------------------------------------------
# pytest configuration
# Replaces the "jest" block in package.json
# ---------------------------------------------------------------------------
[tool.pytest.ini_options]

# Root directory for test discovery — mirrors Jest testMatch: **/src/__tests__/**
testpaths = [
    "tests",          # primary pytest test directory (replaces src/__tests__)
]

# File naming convention for pytest test discovery
python_files = ["test_*.py", "*_test.py"]

# Class naming convention — pytest collects classes prefixed with Test
python_classes = ["Test*"]

# Function naming convention — pytest collects functions prefixed with test_
python_functions = ["test_*"]

# Minimum pytest version required (matches devDependency above)
minversion = "8.2"

# Add src/ to sys.path so application modules are importable without install
pythonpath = ["src"]

# Default addopts flags:
#   -v            verbose output (mirrors Jest's default verbose reporter)
#   --tb=short    short traceback format for readability
#   --strict-markers  fail if unknown markers are used (prevents silent typos)
#   -p no:warnings    suppress deprecation noise during migration period (remove when stable)
addopts = [
    "-v",
    "--tb=short",
    "--strict-markers",
]

# ---------------------------------------------------------------------------
# Markers — declare custom markers used in fixture-based DB isolation tests
# Replaces Jest describe() grouping with pytest marker-based categorisation
# ---------------------------------------------------------------------------
markers = [
    # unit: fast tests with no I/O; use in-memory fakes only
    "unit: marks tests as unit tests (no DB, no network)",
    # integration: tests that exercise the full Flask app with DB fixtures
    "integration: marks tests as integration tests (uses DB fixtures)",
    # db: marks any test that requires the database isolation fixture
    "db: marks tests that require fixture-based DB isolation (scoped per test)",
]

# ---------------------------------------------------------------------------
# Coverage configuration (pytest-cov)
# Replaces Jest collectCoverageFrom and coverageDirectory
# ---------------------------------------------------------------------------
[tool.coverage.run]
# Source paths to measure — mirrors Jest collectCoverageFrom: src/**/*.js
source = ["src"]

# Omit test files themselves from coverage measurement
omit = [
    "tests/*",
    "src/__tests__/*",   # legacy path guard during migration
    "*/conftest.py",
]

# Branch coverage enabled to catch untested conditional paths
branch = true

[tool.coverage.report]
# Fail the build if overall coverage drops below this threshold
# Set conservatively during migration; raise incrementally as coverage improves
fail_under = 70

# Show lines not covered in the terminal report
show_missing = true

# Exclude boilerplate lines from coverage measurement
exclude_lines = [
    "pragma: no cover",
    "if __name__ == .__main__.:",
    "raise NotImplementedError",
    "\\.\\.\\.",          # abstract method stubs
]

[tool.coverage.html]
# HTML coverage report output directory — mirrors Jest coverageDirectory: coverage/
directory = "coverage"