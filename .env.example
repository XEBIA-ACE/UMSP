# requirements.txt
# Python 3.12+ required (upgraded from 3.8, which is EOL)
# Install all dependencies with: pip install -r requirements.txt

# ---------------------------------------------------------------------------
# Web Framework
# Flask 3.1 (upgraded from Flask 1.x, which is EOL)
# Breaking changes: application factory pattern required, removed deprecated
# APIs (e.g., before_first_request, flask.json encoder overrides).
# See: https://flask.palletsprojects.com/en/3.1.x/changes/
# ---------------------------------------------------------------------------
Flask==3.1.0

# Werkzeug is a direct Flask dependency; 3.x is required for Flask 3.x.
# Flask 1.x used Werkzeug 1.x/2.x — the older pin must be removed.
Werkzeug==3.1.3

# ---------------------------------------------------------------------------
# ORM
# SQLAlchemy 2.0 (upgraded from 1.3, which is EOL)
# Breaking changes: legacy Query API removed; use Session.execute() with
# select() constructs. Mapped declarative style is now the standard.
# See: https://docs.sqlalchemy.org/en/20/changelog/migration_20.html
# ---------------------------------------------------------------------------
SQLAlchemy==2.0.36

# Flask-SQLAlchemy 3.x is required for SQLAlchemy 2.0 compatibility.
# Flask-SQLAlchemy 2.x is incompatible with SQLAlchemy 2.0.
Flask-SQLAlchemy==3.1.1

# ---------------------------------------------------------------------------
# Environment-based secrets management
# python-dotenv loads variables from a .env file into os.environ so that
# hardcoded credentials can be removed from source code.
# ---------------------------------------------------------------------------
python-dotenv==1.0.1

# ---------------------------------------------------------------------------
# WSGI server (production)
# Flask's built-in development server must not be used in production.
# Gunicorn is the standard WSGI server for Python web applications.
# ---------------------------------------------------------------------------
gunicorn==23.0.0

# ---------------------------------------------------------------------------
# Development / testing dependencies
# Pin these in a separate requirements-dev.txt if preferred; they are
# included here for projects that use a single requirements file.
# ---------------------------------------------------------------------------

# pytest 8.x supports Python 3.12/3.13 and is compatible with Flask 3.x.
pytest==8.3.4

# pytest-flask provides fixtures for testing Flask 3.x applications.
pytest-flask==1.3.0

# ---------------------------------------------------------------------------
# Dependency vulnerability scanning
# pip-audit scans installed packages against known CVE databases.
# Run as part of CI/CD: pip-audit -r requirements.txt
# ---------------------------------------------------------------------------
pip-audit==2.7.3