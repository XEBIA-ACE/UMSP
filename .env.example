# requirements.txt
# Updated for modernized stack migration
# Python 3.12+ required (upgraded from 3.8 EOL)

# ---------------------------------------------------------------------------
# Core web framework
# Flask 3.1 — upgraded from 1.x (EOL); introduces application factory pattern,
# async support improvements, and removes legacy globals/context behaviour.
# ---------------------------------------------------------------------------
Flask==3.1.0

# Werkzeug is a direct Flask dependency; 3.x is required for Flask 3.x
# (Flask 1.x used Werkzeug 1.x/2.x which is incompatible with Flask 3.x)
Werkzeug==3.1.3

# Click is Flask's CLI dependency; 8.x required for Flask 3.x
click==8.1.8

# Jinja2 templating engine; 3.x required for Flask 3.x
Jinja2==3.1.6

# MarkupSafe is a Jinja2 dependency; must be 2.x for Jinja2 3.x
MarkupSafe==3.0.2

# itsdangerous is used by Flask for session signing; 2.x required for Flask 3.x
itsdangerous==2.2.0

# ---------------------------------------------------------------------------
# ORM / database layer
# SQLAlchemy 2.0 — upgraded from 1.3 (EOL); introduces new-style declarative
# base (DeclarativeBase), 2.0-style session.execute() patterns, and removes
# legacy Query API. All models and session usage must be migrated accordingly.
# ---------------------------------------------------------------------------
SQLAlchemy==2.0.36

# ---------------------------------------------------------------------------
# Environment / secrets management
# python-dotenv — loads environment variables from a .env file so that
# credentials and secrets are never hardcoded in source (replaces any
# hardcoded DB URIs, secret keys, etc. previously in config files).
# ---------------------------------------------------------------------------
python-dotenv==1.0.1

# ---------------------------------------------------------------------------
# Development / testing dependencies
# Pin these in a separate requirements-dev.txt if preferred; included here
# for completeness of a single-file setup.
# ---------------------------------------------------------------------------

# pytest 8.x — compatible with Python 3.12+
pytest==8.3.4

# pytest-flask — provides Flask test client fixtures for pytest
pytest-flask==1.3.0

# ---------------------------------------------------------------------------
# Dependency vulnerability scanning
# pip-audit scans installed packages against known CVE databases; run as part
# of CI/CD pipeline: `pip-audit -r requirements.txt`
# ---------------------------------------------------------------------------
pip-audit==2.7.3