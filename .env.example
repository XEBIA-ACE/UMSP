# requirements.txt
# Python 3.12+ required (upgraded from 3.8, which is EOL)
# Install all dependencies with: pip install -r requirements.txt

# ---------------------------------------------------------------------------
# Web Framework
# Flask 3.1 (upgraded from Flask 1.x, which is EOL)
# Key breaking changes:
#   - Application factory pattern is now the recommended approach
#   - `flask.ext.*` namespace removed (was already deprecated in 1.x)
#   - `before_first_request` decorator removed; use app context setup instead
#   - `FLASK_ENV` environment variable removed; use `FLASK_DEBUG` instead
#   - Signals now require the 'blinker' package explicitly
# ---------------------------------------------------------------------------
Flask==3.1.0

# Blinker is now a required explicit dependency for Flask signals (new in Flask 3.x)
blinker>=1.8.2

# ---------------------------------------------------------------------------
# Database ORM
# SQLAlchemy 2.0 (upgraded from SQLAlchemy 1.3, which is EOL)
# Key breaking changes:
#   - Legacy Query API (`session.query(Model)`) is removed; use `select()` instead
#   - `Engine.execute()` removed; use `Connection.execute()` with explicit transactions
#   - `relationship()` `lazy="dynamic"` removed; use `select` lazy loading or `write_only`
#   - `declarative_base()` moved to `sqlalchemy.orm.DeclarativeBase`
#   - All ORM queries must use 2.0-style `session.execute(select(Model))`
# ---------------------------------------------------------------------------
SQLAlchemy==2.0.36

# Flask-SQLAlchemy 3.x is required for compatibility with both Flask 3.x and SQLAlchemy 2.0
# (Flask-SQLAlchemy 2.x is incompatible with SQLAlchemy 2.0)
Flask-SQLAlchemy==3.1.1

# ---------------------------------------------------------------------------
# Environment-based secrets management
# Replaces hardcoded credentials; load secrets from .env files or environment variables
# Use python-dotenv to load a .env file in development; in production use real env vars
# ---------------------------------------------------------------------------
python-dotenv==1.0.1

# ---------------------------------------------------------------------------
# WSGI server (production)
# Flask's built-in development server must NOT be used in production
# Gunicorn is the recommended WSGI server for Python 3.12+ / Flask 3.x
# ---------------------------------------------------------------------------
gunicorn==22.0.0

# ---------------------------------------------------------------------------
# Development and testing dependencies
# Pin these only in dev; consider splitting into requirements-dev.txt
# ---------------------------------------------------------------------------

# pytest 8.x supports Python 3.12+ and is compatible with Flask 3.x test client
pytest==8.3.3

# pytest-flask provides fixtures for the Flask application factory pattern
pytest-flask==1.3.0

# Safety scans installed packages for known CVEs (dependency vulnerability scanning)
# Run with: safety check -r requirements.txt
safety==3.2.9

# pip-audit is an alternative/complementary vulnerability scanner backed by OSV/PyPI Advisory DB
pip-audit==2.7.3