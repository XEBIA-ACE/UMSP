.github/workflows/ci.yml

name: CI

on:
  push:
    branches:
      - main
  pull_request:
    branches:
      - main

jobs:
  lint:
    name: Lint
    runs-on: ubuntu-latest

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      # Set up the target Python version as defined by the upgrade goal (3.8 EOL → 3.12)
      - name: Set up Python 3.12
        uses: actions/setup-python@v5
        with:
          python-version: "3.12"

      # Cache pip dependencies to speed up subsequent workflow runs
      - name: Cache pip dependencies
        uses: actions/cache@v4
        with:
          path: ~/.cache/pip
          key: ${{ runner.os }}-pip-${{ hashFiles('**/requirements*.txt') }}
          restore-keys: |
            ${{ runner.os }}-pip-

      - name: Install lint dependencies
        run: |
          python -m pip install --upgrade pip
          # flake8: PEP 8 style enforcement
          # black: opinionated code formatter (check mode only, no writes)
          # isort: import order enforcement compatible with black
          pip install flake8 black isort

      # Enforce code formatting with black in check mode (fails if formatting differs)
      - name: Run black (format check)
        run: black --check .

      # Enforce import ordering consistent with black profile
      - name: Run isort (import order check)
        run: isort --check-only --profile black .

      # Enforce PEP 8 style; max-line-length aligned with black default of 88
      - name: Run flake8 (style check)
        run: flake8 . --max-line-length=88 --extend-ignore=E203,W503

  sast:
    name: SAST
    runs-on: ubuntu-latest

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      # Set up Python for bandit execution
      - name: Set up Python 3.12
        uses: actions/setup-python@v5
        with:
          python-version: "3.12"

      - name: Cache pip dependencies
        uses: actions/cache@v4
        with:
          path: ~/.cache/pip
          key: ${{ runner.os }}-pip-sast-${{ hashFiles('**/requirements*.txt') }}
          restore-keys: |
            ${{ runner.os }}-pip-sast-

      - name: Install SAST dependencies
        run: |
          python -m pip install --upgrade pip
          # bandit: Python SAST tool that scans for common security issues
          # safety: checks installed dependencies against known vulnerability databases
          pip install bandit safety

      # Run bandit against the repository; -r for recursive, -ll for medium+ severity
      # Skipping B101 (assert usage) which is acceptable in test files
      - name: Run bandit (SAST scan)
        run: bandit -r . -ll --exclude ./.venv,./tests -f json -o bandit-report.json || bandit -r . -ll --exclude ./.venv,./tests

      # Upload bandit JSON report as a workflow artifact for review
      - name: Upload bandit report
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: bandit-report
          path: bandit-report.json
          retention-days: 30

      # Check dependencies for known CVEs using safety
      # Requires requirements.txt to be present; adjust path if needed
      - name: Run safety (dependency vulnerability check)
        run: safety check --full-report -r requirements.txt

  test:
    name: Test
    runs-on: ubuntu-latest
    # Run tests only after lint and SAST pass to avoid wasting compute on broken code
    needs:
      - lint
      - sast

    strategy:
      matrix:
        # Test against both the minimum supported and latest stable Python versions
        # to catch version-specific regressions introduced by the 3.8 → 3.12 upgrade
        python-version: ["3.12", "3.13"]

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Set up Python ${{ matrix.python-version }}
        uses: actions/setup-python@v5
        with:
          python-version: ${{ matrix.python-version }}

      - name: Cache pip dependencies
        uses: actions/cache@v4
        with:
          path: ~/.cache/pip
          key: ${{ runner.os }}-pip-test-${{ matrix.python-version }}-${{ hashFiles('**/requirements*.txt') }}
          restore-keys: |
            ${{ runner.os }}-pip-test-${{ matrix.python-version }}-

      - name: Install application and test dependencies
        run: |
          python -m pip install --upgrade pip
          # Install application dependencies (Flask 3.1, SQLAlchemy 2.0, etc.)
          pip install -r requirements.txt
          # pytest: test runner; pytest-cov: coverage reporting
          pip install pytest pytest-cov

      # Execute the test suite with coverage reporting
      # --tb=short: concise traceback output for CI logs
      # --cov-report=xml: machine-readable coverage for potential future upload to coverage services
      - name: Run pytest with coverage
        run: |
          pytest --tb=short --cov=. --cov-report=term-missing --cov-report=xml
        env:
          # Inject required environment variables for Flask and SQLAlchemy at test time.
          # Actual secrets must be stored in GitHub Actions repository secrets, not hardcoded.
          # These are safe placeholder values for the test environment only.
          FLASK_ENV: testing
          # SECRET_KEY must be set via GitHub Actions secret in real environments
          SECRET_KEY: ${{ secrets.SECRET_KEY || 'ci-test-only-insecure-key' }}
          # DATABASE_URL should point to a test database; override via repository secret if needed
          DATABASE_URL: ${{ secrets.DATABASE_URL || 'sqlite:///:memory:' }}

      # Upload coverage XML as an artifact for optional downstream processing
      - name: Upload coverage report
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: coverage-report-py${{ matrix.python-version }}
          path: coverage.xml
          retention-days: 30