import os
from flask import Flask
from sqlalchemy import create_engine
from sqlalchemy.orm import sessionmaker

class Config:
    # Flask Configuration
    DEBUG = os.getenv('FLASK_DEBUG', False)  # Enables/Disables debug mode
    TESTING = os.getenv('FLASK_TESTING', False)  # Enable/Disable test mode
    
    # SQLAlchemy Configuration
    SQLALCHEMY_DATABASE_URI = os.getenv('DATABASE_URL', 'sqlite:///default.db')  # Database URI for SQLAlchemy
    SQLALCHEMY_TRACK_MODIFICATIONS = False  # Disable modification tracking for performance
    
    # Note: SQLALCHEMY_ECHO is commonly used for logging queries in the console,
    # see below for environment specific settings

class ProductionConfig(Config):
    ENV = 'production'
    # Enable echo for database connection in a production setup
    SQLALCHEMY_ECHO = os.getenv('SQLALCHEMY_ECHO', 'False').lower() in ('true', '1', 't')  # Controls query logging
    

class DevelopmentConfig(Config):
    ENV = 'development'
    DEBUG = True
    SQLALCHEMY_ECHO = True  # Echo all queries to the terminal for development

class TestingConfig(Config):
    ENV = 'testing'
    TESTING = True
    SQLALCHEMY_ECHO = False  # Suppress query echoing in testing for cleaner output

# Application Creation Function
def create_app(config_class=Config):
    app = Flask(__name__)
    app.config.from_object(config_class)
    
    # Initialize SQLAlchemy engine and session
    engine = create_engine(app.config['SQLALCHEMY_DATABASE_URI'])
    Session = sessionmaker(bind=engine)
    # Flask initialization changes: Flask 3.x recommends application factory method patterns
    
    @app.route('/')
    def hello():
        return "Hello, World!"
    
    return app

# Asynchronous request handling is available in modern Flask, but would
# require specific setup with additional libraries and configurations.
# This template focuses on synchronous operation.