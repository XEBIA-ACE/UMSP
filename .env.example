user-management/src/adapters/inbound/http/routes/healthRoutes.js

'use strict';

/**
 * @fileoverview Health-check routes.
 *
 * Exposes two unauthenticated probe endpoints:
 *   GET /api/health  — liveness probe  (was already present)
 *   GET /api/ready   — readiness probe (NEW: added to support Kubernetes readiness checks)
 */

const { Router } = require('express');
const HealthController = require('../controllers/HealthController');

/**
 * Mounts health-check routes onto an Express Router.
 *
 * @returns {import('express').Router}
 */
function createHealthRouter() {
  const router = Router();
  const controller = new HealthController();

  /** GET /api/health — liveness probe */
  router.get('/', controller.check.bind(controller));

  /**
   * GET /api/ready — readiness probe (NEW)
   *
   * Returns 200 when the service is fully initialised and ready to serve
   * traffic.  Orchestration platforms (e.g. Kubernetes) use this endpoint
   * to decide whether to route requests to the pod.
   *
   * The handler is bound from HealthController.ready(), which must be
   * defined alongside the existing check() method.
   */
  router.get('/ready', controller.ready.bind(controller));

  return router;
}

module.exports = createHealthRouter;