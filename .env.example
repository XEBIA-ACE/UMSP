# No original configuration file is present in the Base Source Code.
# Generating a complete, working configuration file for the Spring Boot payment service
# reflecting the SQLAlchemy session lifecycle fix spec — which maps to JPA/Hibernate
# transaction and HikariCP connection-pool configuration in this Java/Spring Boot codebase.

# File: payment-service/src/main/resources/application.properties

# =============================================================================
# Server
# =============================================================================
server.port=${SERVER_PORT:8080}

# =============================================================================
# DataSource — PostgreSQL
# Credentials and URL are read exclusively from environment variables so that
# no secrets are hardcoded in this file (upgrade requirement).
# =============================================================================

# JDBC URL for the PostgreSQL database.
# Set DATABASE_URL in the environment, e.g.:
#   jdbc:postgresql://localhost:5432/payments
spring.datasource.url=${DATABASE_URL}

# Database username — must be supplied via environment variable.
spring.datasource.username=${DATABASE_USERNAME}

# Database password — must be supplied via environment variable.
spring.datasource.password=${DATABASE_PASSWORD}

# PostgreSQL JDBC driver (resolved automatically by Spring Boot auto-configuration,
# but declared explicitly for clarity).
spring.datasource.driver-class-name=org.postgresql.Driver

# =============================================================================
# HikariCP connection pool
# Correct pool sizing is the primary defence against connection-leak exhaustion.
# Every session that is not closed returns its connection to this pool; if the
# pool is saturated, new requests block until connection-timeout is reached.
# =============================================================================

# Maximum number of connections kept in the pool.
# Size this to (number of application threads that can be in a DB call simultaneously).
# Default HikariCP value is 10; set explicitly so the value is visible and reviewable.
spring.datasource.hikari.maximum-pool-size=${DB_POOL_MAX_SIZE:10}

# Minimum number of idle connections HikariCP maintains in the pool.
# Keeping this equal to maximum-pool-size avoids connection ramp-up latency under burst load.
spring.datasource.hikari.minimum-idle=${DB_POOL_MIN_IDLE:10}

# Maximum milliseconds a caller will wait for a connection from the pool before
# a SQLException is thrown. Fail fast rather than queue indefinitely.
# Changed from HikariCP default (30 000 ms) to 5 000 ms to surface leaks quickly.
spring.datasource.hikari.connection-timeout=${DB_POOL_CONNECTION_TIMEOUT_MS:5000}

# Maximum lifetime of a connection in the pool (milliseconds).
# Must be shorter than the database server's wait_timeout / tcp keepalive to avoid
# receiving stale connections. Default: 1 800 000 (30 min).
spring.datasource.hikari.max-lifetime=${DB_POOL_MAX_LIFETIME_MS:1800000}

# Maximum amount of time a connection is allowed to sit idle in the pool (milliseconds).
# Connections idle longer than this are retired and replaced.
spring.datasource.hikari.idle-timeout=${DB_POOL_IDLE_TIMEOUT_MS:600000}

# SQL query used by HikariCP to validate that a connection is still alive before
# handing it to the application. PostgreSQL supports the lightweight SELECT 1.
spring.datasource.hikari.connection-test-query=SELECT 1

# Pool name — appears in JMX metrics and log output, making it easy to correlate
# pool-exhaustion warnings with this specific service.
spring.datasource.hikari.pool-name=PaymentServicePool

# Enable HikariCP leak detection. Any connection held open longer than this
# threshold (milliseconds) will produce a WARNING log with a stack trace showing
# where the connection was acquired. Set to 0 to disable.
# 2 000 ms is aggressive enough to catch runaway transactions in development/staging.
# Raise or disable in production if legitimate long-running queries trigger false positives.
spring.datasource.hikari.leak-detection-threshold=${DB_POOL_LEAK_DETECTION_MS:2000}

# =============================================================================
# JPA / Hibernate
# =============================================================================

# Hibernate dialect for PostgreSQL. Spring Boot 3.x auto-detects this, but
# declaring it explicitly prevents surprises when the auto-detection heuristic
# changes across minor versions.
spring.jpa.database-platform=org.hibernate.dialect.PostgreSQLDialect

# DDL auto strategy.
# "validate" — Hibernate checks that the schema matches the entity model at startup
# and throws if there is a mismatch, but never modifies the schema.
# Schema changes are managed by Flyway (see below).
# Do NOT use "create", "create-drop", or "update" in production.
spring.jpa.hibernate.ddl-auto=validate

# Show SQL statements in the log. Disable in production to reduce log volume.
spring.jpa.show-sql=${JPA_SHOW_SQL:false}

# Format logged SQL for readability (only relevant when show-sql is true).
spring.jpa.properties.hibernate.format_sql=true

# =============================================================================
# Transaction management
# The fixes below ensure that every JPA session is bound to a transaction,
# committed on success, and rolled back (with the connection returned to the pool)
# on any exception — preventing the connection leaks described in the spec.
# =============================================================================

# Require an active transaction for all Spring Data repository calls.
# This is the default in Spring Boot 3.x / Spring Framework 6.x, declared here
# explicitly as a reminder that @Transactional on service methods is mandatory.
spring.jpa.properties.hibernate.connection.handling_mode=DELAYED_ACQUISITION_AND_RELEASE_AFTER_TRANSACTION

# Default transaction timeout in seconds. Any transaction running longer than this
# is automatically rolled back and its connection returned to the pool.
# Prevents long-running or forgotten transactions from holding connections indefinitely.
# Set to -1 to use the database server default (not recommended).
spring.transaction.default-timeout=${TX_DEFAULT_TIMEOUT_SECONDS:30}

# Roll back a transaction that has been marked rollback-only rather than throwing
# an exception at commit time. This is the Spring default; declared explicitly for
# auditability.
spring.jpa.properties.hibernate.transaction.jta.platform=

# =============================================================================
# Flyway — database schema migrations
# =============================================================================

# Enable Flyway. Spring Boot auto-configures Flyway when it is on the classpath
# and this property is true.
spring.flyway.enabled=true

# Location of migration scripts on the classpath.
spring.flyway.locations=classpath:db/migration

# Flyway uses the same DataSource as JPA by default; no separate URL needed.

# =============================================================================
# OAuth2 Resource Server — JWT validation
# =============================================================================

# Issuer URI used to fetch the JWKS endpoint and validate incoming JWT bearer tokens.
# Must be set in the environment; no default is provided to prevent accidental
# acceptance of tokens from an unintended issuer.
spring.security.oauth2.resourceserver.jwt.issuer-uri=${OAUTH2_ISSUER_URI}

# =============================================================================
# Notification
# =============================================================================

# Whether to attempt real email delivery for payment/refund confirmations.
# Defaults to false so that development and test environments do not require SMTP.
notification.email.enabled=${NOTIFICATION_EMAIL_ENABLED:false}

# =============================================================================
# Payment gateway credentials
# All values are read from environment variables — never hardcoded.
# =============================================================================

# Stripe secret API key (sk_test_… for test, sk_live_… for production).
stripe.api.key=${STRIPE_API_KEY}

# PayPal application client ID.
paypal.client.id=${PAYPAL_CLIENT_ID}

# PayPal application client secret.
paypal.client.secret=${PAYPAL_CLIENT_SECRET}

# PayPal operating mode: "sandbox" for testing, "live" for production.
paypal.mode=${PAYPAL_MODE:sandbox}

# =============================================================================
# Actuator — management endpoints
# Expose only the health endpoint publicly; all others require authentication.
# =============================================================================
management.endpoints.web.exposure.include=health
management.endpoint.health.show-details=when-authorized

# =============================================================================
# Logging
# =============================================================================

# Root log level. Override per-package below as needed.
logging.level.root=INFO

# Log HikariCP pool events (connection acquisition, timeouts, leak warnings).
# Set to DEBUG during initial deployment to verify pool behaviour under load.
logging.level.com.zaxxer.hikari=INFO

# Log Hibernate SQL binding parameters (useful for diagnosing slow queries).
# Disable in production.
logging.level.org.hibernate.type.descriptor.sql=WARN

# Application package log level.
logging.level.com.payments=INFO