name: CI

on:
  push:
    branches:
      - main
  pull_request:
    branches:
      - main

jobs:
  lint:
    name: Lint
    runs-on: ubuntu-latest

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      # Set up the target Python version (upgraded from 3.8 EOL to 3.12)
      - name: Set up Python 3.12
        uses: actions/setup-python@v5
        with:
          python-version: "3.12"

      - name: Cache pip dependencies
        uses: actions/cache@v4
        with:
          path: ~/.cache/pip
          key: ${{ runner.os }}-pip-${{ hashFiles('**/requirements*.txt') }}
          restore-keys: |
            ${{ runner.os }}-pip-

      - name: Install lint dependencies
        run: |
          python -m pip install --upgrade pip
          # flake8: PEP8 style and syntax lint; black: opinionated formatter check
          pip install flake8 black

      - name: Run flake8
        run: |
          # Fail on syntax errors or undefined names; warn on style issues
          flake8 . --count --select=E9,F63,F7,F82 --show-source --statistics
          flake8 . --count --exit-zero --max-complexity=10 --max-line-length=88 --statistics

      - name: Run black (format check)
        run: |
          # Check formatting without modifying files; non-zero exit if changes needed
          black --check .

  test:
    name: Test
    runs-on: ubuntu-latest
    # Run tests against both 3.12 and 3.13 to validate compatibility
    strategy:
      matrix:
        python-version: ["3.12", "3.13"]

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Set up Python ${{ matrix.python-version }}
        uses: actions/setup-python@v5
        with:
          python-version: ${{ matrix.python-version }}

      - name: Cache pip dependencies
        uses: actions/cache@v4
        with:
          path: ~/.cache/pip
          key: ${{ runner.os }}-pip-${{ matrix.python-version }}-${{ hashFiles('**/requirements*.txt') }}
          restore-keys: |
            ${{ runner.os }}-pip-${{ matrix.python-version }}-

      - name: Install dependencies
        run: |
          python -m pip install --upgrade pip
          # Install application dependencies; requirements.txt must reflect
          # upgraded versions: Flask 3.x, SQLAlchemy 2.0, Python 3.12+
          pip install -r requirements.txt
          # pytest: test runner; pytest-cov: coverage reporting
          pip install pytest pytest-cov

      - name: Run tests with coverage
        run: |
          pytest --cov=. --cov-report=term-missing --cov-report=xml
        env:
          # Secrets must be supplied via GitHub Actions secrets, not hardcoded.
          # These environment variables replace any previously hardcoded credentials.
          FLASK_ENV: testing
          SECRET_KEY: ${{ secrets.SECRET_KEY }}
          DATABASE_URL: ${{ secrets.DATABASE_URL }}

      - name: Upload coverage report
        uses: actions/upload-artifact@v4
        with:
          name: coverage-report-${{ matrix.python-version }}
          path: coverage.xml
          # Retain coverage artifacts for 7 days
          retention-days: 7

  security:
    name: Security Scan
    runs-on: ubuntu-latest

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Set up Python 3.12
        uses: actions/setup-python@v5
        with:
          python-version: "3.12"

      - name: Cache pip dependencies
        uses: actions/cache@v4
        with:
          path: ~/.cache/pip
          key: ${{ runner.os }}-pip-security-${{ hashFiles('**/requirements*.txt') }}
          restore-keys: |
            ${{ runner.os }}-pip-security-

      - name: Install security scan tools
        run: |
          python -m pip install --upgrade pip
          # pip-audit: scans installed packages against PyPI advisory database
          # bandit: static analysis tool for common Python security issues
          pip install pip-audit bandit

      - name: Install application dependencies for audit
        run: |
          pip install -r requirements.txt

      - name: Run pip-audit (dependency vulnerability scan)
        run: |
          # Scans all installed packages for known CVEs via PyPI advisory DB.
          # Fails the job if any vulnerability with a fix available is found.
          pip-audit --requirement requirements.txt --output json > pip-audit-report.json || true
          pip-audit --requirement requirements.txt

      - name: Run bandit (static security analysis)
        run: |
          # -r: recursive scan of source; -ll: report medium and high severity only
          # -x: exclude test directories from scan
          bandit -r . -ll -x ./tests,./test

      - name: Upload pip-audit report
        uses: actions/upload-artifact@v4
        with:
          name: pip-audit-report
          path: pip-audit-report.json
          retention-days: 7