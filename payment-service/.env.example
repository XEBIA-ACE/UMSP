# ============================================================
# Payment Service – Environment Variables Example
# ============================================================
# Copy this file to .env and fill in the real values.
# Never commit the actual .env file to version control.
# ============================================================

# HTTP server port
SERVER_PORT=8080

# Stripe gateway credentials
# Obtain from https://dashboard.stripe.com/apikeys
STRIPE_API_KEY=sk_test_your_stripe_key_here

# PayPal gateway credentials
# Obtain from https://developer.paypal.com/dashboard/applications
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
# sandbox | live
PAYPAL_MODE=sandbox

# OAuth2 / JWT issuer URI (e.g. Keycloak, Auth0, Spring Authorization Server)
OAUTH2_ISSUER_URI=https://your-auth-server.com

# Email notification toggle (true | false)
NOTIFICATION_EMAIL_ENABLED=false
